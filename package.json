{
  "name": "calebkautai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "fetch-images": "node scripts/fetch-images.mjs && node scripts/optimize-images.mjs && node scripts/pixel-sprites.mjs",
    "compress-audio": "node scripts/compress-audio.mjs",
    "reviews": "node scripts/reviews.mjs",
    "test": "node --test tests/unit/*.test.js && playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "pixel-sprites": "node scripts/pixel-sprites.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.0"
  }
}
